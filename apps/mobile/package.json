{
  "name": "@teammeet/mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "EXPO_USE_WATCHMAN=1 expo start",
    "start:dev-client": "EXPO_USE_WATCHMAN=1 expo start --dev-client",
    "dev:mobile": "EXPO_USE_WATCHMAN=1 expo start",
    "android": "EXPO_USE_WATCHMAN=1 ./scripts/with-android-env.sh expo start --android --dev-client",
    "android:doctor": "./scripts/with-android-env.sh sh -c 'printf \"ANDROID_HOME=%s\\nJAVA_HOME=%s\\n\" \"$ANDROID_HOME\" \"$JAVA_HOME\"; java -version; command -v adb; command -v emulator || true'",
    "ios": "EXPO_USE_WATCHMAN=1 expo start --ios --dev-client",
    "web": "EXPO_USE_WATCHMAN=1 expo start --web",
    "prebuild": "EXPO_USE_WATCHMAN=1 expo prebuild",
    "prebuild:clean": "EXPO_USE_WATCHMAN=1 expo prebuild --clean",
    "run:android": "EXPO_USE_WATCHMAN=1 ./scripts/with-android-env.sh expo run:android",
    "run:ios": "EXPO_USE_WATCHMAN=1 expo run:ios",
    "config": "expo config --type public",
    "config:introspect": "expo config --type introspect",
    "eas:ios:list": "eas build:list --platform ios --limit 20",
    "eas:ios:production": "eas build --platform ios --profile production",
    "eas:ios:production:auto-submit": "eas build --platform ios --profile production --auto-submit",
    "eas:submit:ios": "eas submit --platform ios --latest",
    "typecheck": "tsc --noEmit",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint .",
    "check:expo": "expo install --check",
    "verify": "bun run check:expo && bun run typecheck && bun run lint && bun run test",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --reporters=default"
  },
  "dependencies": {
    "@bacons/apple-targets": "^0.2.0",
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/drawer": "^7.5.0",
    "@react-navigation/elements": "^2.9.5",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.86.2",
    "@teammeet/core": "workspace:*",
    "@teammeet/types": "workspace:*",
    "@teammeet/validation": "workspace:*",
    "expo": "~54.0.36",
    "expo-apple-authentication": "~8.0.8",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "^15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "^15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-modules-core": "~3.0.29",
    "expo-notifications": "^0.32.16",
    "expo-quick-actions": "^6.0.1",
    "expo-router": "~6.0.24",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-updates": "~29.0.19",
    "expo-web-browser": "~15.0.10",
    "lucide-react-native": "^0.562.0",
    "posthog-react-native": "^4.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/runtime": "^7.28.6",
    "@eslint/js": "^8",
    "@expo/ngrok": "^4.1.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.29",
    "@types/react": "~19.1.10",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "babel-preset-expo": "^54.0.9",
    "eslint": "^8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "typescript": "~5.9.2"
  },
  "private": true
}
